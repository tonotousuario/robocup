# =============================================================
# RoboLeague — variables de PRODUCCIÓN (Docker + Cloudflare Tunnel)
# En el VPS:  cp .env.production.example .env.production  y rellena lo marcado.
# NO lo subas a git con secretos reales.
# =============================================================

APP_NAME=RoboLeague
APP_ENV=production
APP_KEY= # <-- generar:  ./scripts/deploy.sh genera, o php artisan key:generate
APP_DEBUG=false
APP_URL=https://roboleague.tlapala.com # <-- tu dominio (HTTPS lo pone Cloudflare)

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---- Base de datos (servicio "db" del compose; por TCP, no socket) ----
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=roboleague
DB_USERNAME=roboleague
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA # <-- contraseña fuerte

# ---- Sesión / caché / colas (todo en BD; sin Redis) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true # cookies solo por HTTPS (Cloudflare)
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Inertia SSR apagado en prod (CSR puro = despliegue simple) ----
INERTIA_SSR_ENABLED=false

# ---- Correo (Fortify: verificación / 2FA). 'log' = no envía, escribe en logs.
# Configura un SMTP real si quieres correos de verdad.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@roboleague.tlapala.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---- Cloudflare Tunnel ----
# Token del túnel creado en Zero Trust > Networks > Tunnels (hostname -> http://web:80)
CLOUDFLARE_TUNNEL_TOKEN=eyJ...tu-token-del-tunel-aqui...
